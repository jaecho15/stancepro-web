# Supabase + Auth email configuration example
# Copy this file to .env.local and fill in your values.

RESEND_API_KEY=
NEXT_PUBLIC_SITE_URL=
SUPABASE_URL=
# Server-side reads and writes (Vercel Python functions, cron workers). The
# serving tables are signed-in-only, so a publishable/anon key gets an empty
# array back, not an error - set the secret here. Do NOT set SUPABASE_ANON_KEY
# for the server: the workers would read with it and see nothing.
SUPABASE_SECRET_KEY=

# Web app public Supabase keys (required on Vercel for /internal/* routes)
NEXT_PUBLIC_SUPABASE_URL=https://ryiitcblrrqvjvxkobpf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
# Or newer publishable key (preferred):
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Internal magic-link redirect (add in Supabase Auth → URL configuration):
# https://stance-pro.com/internal/auth/callback
# Legacy (still forwarded): https://stance-pro.com/brand-review/auth/callback







